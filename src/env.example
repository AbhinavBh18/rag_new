# ── Google Gemini ────────────────────────────────────────────────────
GEMINI_API_KEY=your_key_here
LLM_MODEL_NAME=gemini-3.5-flash
# Leave EMPTY to omit the temperature parameter entirely — the newest
# Gemini 3.x endpoints have deprecated temperature/top_p/top_k.
LLM_TEMPERATURE=0.1
JUDGE_MODEL_NAME=gemini-3.5-flash

# ── Qdrant ───────────────────────────────────────────────────────────
# Leave QDRANT_URL EMPTY for embedded mode: no server, no Docker, no key.
# Storage goes to data/qdrant_db/.
# To use a server instead:  docker run -p 6333:6333 qdrant/qdrant
#   QDRANT_URL=http://localhost:6333
# For Qdrant Cloud, also set QDRANT_API_KEY.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=peft_papers

# ── Retrieval ────────────────────────────────────────────────────────
RETRIEVAL_MODE=hybrid
